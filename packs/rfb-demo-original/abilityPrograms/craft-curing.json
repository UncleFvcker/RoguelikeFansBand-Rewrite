{
  "$schema": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/ability-program.schema.json",
  "formatVersion": 1,
  "id": "demo.ability-program.craft-curing",
  "input": "self",
  "steps": [
    {
      "type": "remove-status",
      "statusKindId": "rfb.status.fear"
    },
    {
      "type": "reduce-status",
      "statusKindId": "rfb.status.poison",
      "amount": 150,
      "currentDivisor": 3
    },
    {
      "type": "remove-status",
      "statusKindId": "rfb.status.stun"
    },
    {
      "type": "remove-status",
      "statusKindId": "rfb.status.bleeding"
    },
    {
      "type": "remove-status",
      "statusKindId": "rfb.status.hallucination"
    }
  ]
}
