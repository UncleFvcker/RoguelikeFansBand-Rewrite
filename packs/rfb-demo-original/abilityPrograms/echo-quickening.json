{
  "$schema": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/ability-program.schema.json",
  "formatVersion": 1,
  "id": "demo.ability-program.echo-quickening",
  "input": "self",
  "steps": [
    {
      "type": "apply-status",
      "statusKindId": "rfb.status.haste",
      "intensity": 1,
      "durationTicks": 30,
      "stacking": "extend"
    },
    {
      "type": "remove-status",
      "statusKindId": "rfb.status.slow"
    }
  ]
}
