mogaminator-diagnostic-empty-condition = Line { $line }, column { $column }: condition cannot be empty.
mogaminator-diagnostic-expected-condition-function = Line { $line }, column { $column }: expected a condition function.
mogaminator-diagnostic-unknown-condition-function = Line { $line }, column { $column }: unknown condition function ({ $argument }).
mogaminator-diagnostic-unknown-condition-variable = Line { $line }, column { $column }: unknown condition variable ({ $argument }).
mogaminator-diagnostic-unterminated-condition-expression = Line { $line }, column { $column }: unterminated condition expression.
mogaminator-diagnostic-unexpected-condition-close = Line { $line }, column { $column }: unexpected condition close.
mogaminator-diagnostic-trailing-condition-input = Line { $line }, column { $column }: trailing condition input ({ $argument }).
mogaminator-diagnostic-invalid-numeric-predicate = Line { $line }, column { $column }: invalid numeric predicate ({ $argument }).
mogaminator-diagnostic-missing-rule-body = Line { $line }, column { $column }: rule has no match body.
mogaminator-diagnostic-unsupported-predicate = Line { $line }: predicate is not supported yet ({ $argument }).
mogaminator-diagnostic-unsupported-variable = Line { $line }: variable is not supported yet ({ $argument }).
mogaminator-diagnostic-invalid-condition-arity = Line { $line }: condition function has the wrong argument count ({ $argument }).
