{
  "$defs": {
    "SkillKind": {
      "enum": [
        "disarming",
        "device",
        "saving-throw",
        "stealth",
        "search",
        "perception",
        "melee",
        "ranged",
        "throwing",
        "digging"
      ],
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/skill.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "descriptionKey": {
      "type": "string"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SkillKind"
    },
    "maximum": {
      "format": "int32",
      "type": "integer"
    },
    "nameKey": {
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "nameKey",
    "descriptionKey",
    "kind",
    "maximum",
    "tags"
  ],
  "title": "SkillDefinition",
  "type": "object"
}
