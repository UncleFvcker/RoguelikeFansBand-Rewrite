{
  "$defs": {
    "ActorDamageType": {
      "enum": [
        "physical",
        "acid",
        "electricity",
        "fire",
        "cold",
        "poison",
        "light",
        "dark",
        "confusion",
        "nether",
        "nexus",
        "sound",
        "shards",
        "chaos",
        "disenchant",
        "time",
        "mana",
        "gravity",
        "inertia",
        "plasma",
        "force",
        "nuke",
        "disintegrate",
        "storm",
        "holy-fire",
        "hell-fire",
        "ice",
        "water",
        "psi"
      ],
      "type": "string"
    },
    "ActorMovementMode": {
      "enum": [
        "aquatic",
        "climb",
        "fly",
        "pass-wall",
        "swim"
      ],
      "type": "string"
    },
    "TerrainTrapDefinition": {
      "additionalProperties": false,
      "properties": {
        "avoidedByMovementModes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActorMovementMode"
          },
          "type": "array"
        },
        "damage": {
          "format": "int32",
          "type": "integer"
        },
        "damageType": {
          "$ref": "#/$defs/ActorDamageType",
          "default": "physical"
        },
        "disarmCheckDifficulty": {
          "format": "int32",
          "type": "integer"
        },
        "disarmToTerrainId": {
          "type": "string"
        },
        "savingThrowDifficulty": {
          "default": null,
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "damage",
        "disarmToTerrainId",
        "disarmCheckDifficulty"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/terrain.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "allowsWallPassage": {
      "default": false,
      "type": "boolean"
    },
    "bashCheckDifficulty": {
      "default": null,
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    },
    "bashToTerrainId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "blocksSight": {
      "type": "boolean"
    },
    "closeToTerrainId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "concealedAsTerrainId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "descriptionKey": {
      "type": "string"
    },
    "digCheckDifficulty": {
      "default": null,
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    },
    "digToTerrainId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "glyph": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "monsterDestroyToTerrainId": {
      "default": null,
      "description": "Result of the original `FF_HURT_DISI` terrain transition.",
      "type": [
        "string",
        "null"
      ]
    },
    "monsterDoorPower": {
      "default": null,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "monsterUnlockToTerrainId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "movementModes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ActorMovementMode"
      },
      "type": "array"
    },
    "nameKey": {
      "type": "string"
    },
    "openCheckDifficulty": {
      "default": null,
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    },
    "openToTerrainId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "perceptionCheckDifficulty": {
      "default": null,
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    },
    "searchCheckDifficulty": {
      "default": null,
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "trap": {
      "anyOf": [
        {
          "$ref": "#/$defs/TerrainTrapDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "walkable": {
      "type": "boolean"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "nameKey",
    "descriptionKey",
    "glyph",
    "walkable",
    "blocksSight",
    "tags"
  ],
  "title": "TerrainDefinition",
  "type": "object"
}
