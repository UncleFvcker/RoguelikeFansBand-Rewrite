{
  "$defs": {
    "ActorDamageType": {
      "enum": [
        "physical",
        "acid",
        "electricity",
        "fire",
        "cold",
        "poison",
        "light",
        "dark",
        "blindness",
        "fear",
        "confusion",
        "nether",
        "nexus",
        "sound",
        "shards",
        "chaos",
        "disenchant",
        "time",
        "mana",
        "gravity",
        "inertia",
        "plasma",
        "force",
        "nuke",
        "disintegrate",
        "storm",
        "holy-fire",
        "hell-fire",
        "ice",
        "water",
        "psi"
      ],
      "type": "string"
    },
    "ActorResistanceLevel": {
      "description": "Content-declared resistance tier; `normal` is expressed by omission.",
      "enum": [
        "vulnerable",
        "resistant",
        "strong",
        "immune"
      ],
      "type": "string"
    },
    "MutationRatingDefinition": {
      "enum": [
        "awful",
        "bad",
        "average",
        "good",
        "great"
      ],
      "type": "string"
    },
    "StatModifiers": {
      "additionalProperties": false,
      "properties": {
        "attack": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "charisma": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "constitution": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "defense": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "dexterity": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "intelligence": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "maxHp": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "speed": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "strength": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "wisdom": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/mutation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "armorClass": {
      "default": 0,
      "description": "Direct armor-class adjustment from the original mutation bonus.",
      "format": "int32",
      "type": "integer"
    },
    "contactAura": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorDamageType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "type": "string"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "infravision": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "levitation": {
      "default": false,
      "type": "boolean"
    },
    "lightRadius": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "modifiers": {
      "$ref": "#/$defs/StatModifiers",
      "default": {
        "attack": 0,
        "charisma": 0,
        "constitution": 0,
        "defense": 0,
        "dexterity": 0,
        "intelligence": 0,
        "maxHp": 0,
        "speed": 0,
        "strength": 0,
        "wisdom": 0
      }
    },
    "name": {
      "type": "string"
    },
    "randomWeight": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "rating": {
      "$ref": "#/$defs/MutationRatingDefinition"
    },
    "regenerationRateModifierPercent": {
      "default": 0,
      "description": "Additive percentage adjustment to the natural HP regeneration rate.",
      "format": "int32",
      "type": "integer"
    },
    "removesOnGain": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resistances": {
      "additionalProperties": false,
      "properties": {
        "acid": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "blindness": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "chaos": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "cold": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "confusion": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "dark": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "disenchant": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "disintegrate": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "electricity": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "fear": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "fire": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "force": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "gravity": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "hell-fire": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "holy-fire": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "ice": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "inertia": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "light": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "mana": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nether": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nexus": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nuke": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "physical": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "plasma": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "poison": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "psi": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "shards": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "sound": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "storm": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "time": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "water": {
          "$ref": "#/$defs/ActorResistanceLevel"
        }
      },
      "type": "object"
    },
    "savingThrowSkill": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "savingThrowSkillPerFiveLevels": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "sourceIndex": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "statusImmunities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "telepathy": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "name",
    "description",
    "rating",
    "sourceIndex",
    "randomWeight"
  ],
  "title": "MutationDefinition",
  "type": "object"
}
