{
  "$defs": {
    "AbilityStatusStackingDefinition": {
      "enum": [
        "replace",
        "extend",
        "keep-strongest"
      ],
      "type": "string"
    },
    "ActorDamageType": {
      "enum": [
        "physical",
        "acid",
        "electricity",
        "fire",
        "cold",
        "poison",
        "light",
        "dark",
        "blindness",
        "fear",
        "confusion",
        "nether",
        "nexus",
        "sound",
        "shards",
        "chaos",
        "disenchant",
        "time",
        "mana",
        "gravity",
        "inertia",
        "plasma",
        "force",
        "nuke",
        "disintegrate",
        "storm",
        "holy-fire",
        "hell-fire",
        "ice",
        "water",
        "psi",
        "curse"
      ],
      "type": "string"
    },
    "ActorResistanceLevel": {
      "description": "Content-declared resistance tier; `normal` is expressed by omission.",
      "enum": [
        "vulnerable",
        "resistant",
        "strong",
        "immune"
      ],
      "type": "string"
    },
    "ChaosPatronDefinition": {
      "additionalProperties": false,
      "properties": {
        "favoredAttribute": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechniqueAttribute"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rewards": {
          "items": {
            "$ref": "#/$defs/ChaosPatronRewardKind"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "rewards"
      ],
      "type": "object"
    },
    "ChaosPatronRewardKind": {
      "enum": [
        "polymorph-self",
        "gain-experience",
        "lose-experience",
        "good-object",
        "great-object",
        "chaos-weapon",
        "good-objects",
        "great-objects",
        "ty-curse",
        "summon-monsters",
        "high-summon",
        "havoc",
        "gain-attribute",
        "lose-attribute",
        "ruin-attributes",
        "augment-attributes",
        "polymorph-wounds",
        "full-healing",
        "hurt-badly",
        "curse-weapon",
        "curse-armor",
        "anger",
        "wrath",
        "destruction",
        "genocide",
        "mass-genocide",
        "dispel-monsters",
        "ignore",
        "undead-servant",
        "demon-servant",
        "monster-servant"
