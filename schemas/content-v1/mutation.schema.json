{
  "$defs": {
    "MutationRatingDefinition": {
      "enum": [
        "awful",
        "bad",
        "average",
        "good",
        "great"
      ],
      "type": "string"
    },
    "StatModifiers": {
      "additionalProperties": false,
      "properties": {
        "attack": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "charisma": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "constitution": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "defense": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "dexterity": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "intelligence": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "maxHp": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "speed": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "strength": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "wisdom": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/mutation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "armorClass": {
      "default": 0,
      "description": "Direct armor-class adjustment from the original mutation bonus.",
      "format": "int32",
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "modifiers": {
      "$ref": "#/$defs/StatModifiers",
      "default": {
        "attack": 0,
        "charisma": 0,
        "constitution": 0,
        "defense": 0,
        "dexterity": 0,
        "intelligence": 0,
        "maxHp": 0,
        "speed": 0,
        "strength": 0,
        "wisdom": 0
      }
    },
    "name": {
      "type": "string"
    },
    "randomWeight": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "rating": {
      "$ref": "#/$defs/MutationRatingDefinition"
    },
    "removesOnGain": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sourceIndex": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "name",
    "description",
    "rating",
    "sourceIndex",
    "randomWeight"
  ],
  "title": "MutationDefinition",
  "type": "object"
}
