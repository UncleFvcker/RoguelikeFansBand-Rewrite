          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "light": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "mana": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nether": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nexus": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nuke": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "physical": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "plasma": {
