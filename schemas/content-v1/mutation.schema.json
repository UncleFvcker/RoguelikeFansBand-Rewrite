      "type": "string"
    },
    "MutationActivationCostScalingDefinition": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "levelInterval": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "startLevel": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "startLevel",
        "levelInterval",
        "amount"
      ],
      "type": "object"
    },
    "MutationActivationDefinition": {
      "additionalProperties": false,
      "properties": {
        "abilityId": {
          "type": "string"
        },
        "baseFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "cost": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "costScaling": {
          "anyOf": [
            {
              "$ref": "#/$defs/MutationActivationCostScalingDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "governingAttribute": {
          "$ref": "#/$defs/TechniqueAttribute"
        },
        "minimumFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minimumLevel": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "minimumLevel",
        "governingAttribute",
        "cost",
        "baseFailurePercent",
        "abilityId"
      ],
      "type": "object"
    },
    "MutationInnateAttackDefinition": {
      "additionalProperties": false,
      "properties": {
        "damageDice": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "damageSides": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "damageType": {
          "$ref": "#/$defs/ActorDamageType",
          "default": "physical"
        },
        "name": {
          "type": "string"
        },
        "toDamage": {
          "format": "int32",
          "type": "integer"
        },
        "toHit": {
          "format": "int32",
          "type": "integer"
        },
        "weightTenthsPound": {
          "description": "Original RFB attack weight used by the innate critical-hit roll.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "toHit",
        "toDamage",
        "damageDice",
        "damageSides",
        "weightTenthsPound"
      ],
      "type": "object"
    },
    "MutationPeriodicEffectDefinition": {
      "oneOf": [
