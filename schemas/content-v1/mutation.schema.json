  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/mutation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "activation": {
      "anyOf": [
        {
          "$ref": "#/$defs/MutationActivationDefinition"
        },
        {
          "type": "null"
        }
      ]
    },
    "armorClass": {
      "default": 0,
      "description": "Direct armor-class adjustment from the original mutation bonus.",
      "format": "int32",
      "type": "integer"
    },
    "autoIdentifyItems": {
      "default": false,
      "type": "boolean"
    },
    "blackMarketStandardPrices": {
      "default": false,
      "type": "boolean"
    },
    "chaosPatrons": {
      "items": {
        "$ref": "#/$defs/ChaosPatronDefinition"
      },
      "type": "array"
    },
    "contactAura": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorDamageType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "type": "string"
    },
    "dispelResistancePercent": {
      "default": 0,
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "infravision": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "innateAttack": {
      "anyOf": [
        {
          "$ref": "#/$defs/MutationInnateAttackDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "killExperienceBonusPercent": {
      "default": 0,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "levitation": {
      "default": false,
      "type": "boolean"
    },
    "lightRadius": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "mightyThrow": {
      "default": false,
      "type": "boolean"
    },
    "modifiers": {
      "$ref": "#/$defs/StatModifiers",
      "default": {
        "attack": 0,
        "charisma": 0,
        "constitution": 0,
        "defense": 0,
        "devicePowerBonus": 0,
        "dexterity": 0,
        "intelligence": 0,
        "maxHp": 0,
        "speed": 0,
        "spellPowerBonus": 0,
        "strength": 0,
        "wisdom": 0
      }
    },
    "movementEnergyMultiplier": {
      "anyOf": [
        {
          "$ref": "#/$defs/MutationRatioDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "type": "string"
    },
    "normalAppearance": {
      "default": false,
      "description": "Masks charisma changes from other mutations and guarantees the\nlevel-scaled minimum appearance used by the original Ill Norm mutation.",
      "type": "boolean"
    },
    "perceptionSkill": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "periodicEffect": {
      "anyOf": [
        {
          "$ref": "#/$defs/MutationPeriodicEffectDefinition"
        },
        {
          "type": "null"
        }
      ]
    },
    "randomSelectionEnabled": {
      "default": true,
      "type": "boolean"
    },
    "randomWeight": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "rating": {
      "$ref": "#/$defs/MutationRatingDefinition"
    },
    "regenerationRateModifierPercent": {
      "default": 0,
      "description": "Additive percentage adjustment to the natural HP regeneration rate.",
      "format": "int32",
      "type": "integer"
    },
    "relativeExperienceMultiplier": {
      "anyOf": [
        {
          "$ref": "#/$defs/MutationRatioDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "removesOnGain": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resistances": {
      "additionalProperties": false,
