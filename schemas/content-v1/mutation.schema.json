{
  "$defs": {
    "MutationRatingDefinition": {
      "enum": [
        "awful",
        "bad",
        "average",
        "good",
        "great"
      ],
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/mutation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "randomWeight": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "rating": {
      "$ref": "#/$defs/MutationRatingDefinition"
    },
    "removesOnGain": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sourceIndex": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "name",
    "description",
    "rating",
    "sourceIndex",
    "randomWeight"
  ],
  "title": "MutationDefinition",
  "type": "object"
}
