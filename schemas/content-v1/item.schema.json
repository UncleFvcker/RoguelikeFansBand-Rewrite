      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "glyph": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "initialCurse": {
      "anyOf": [
        {
          "$ref": "#/$defs/ItemCurseSeverityDefinition"
