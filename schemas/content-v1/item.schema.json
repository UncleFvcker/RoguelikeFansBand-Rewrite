        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Curse stamped onto newly generated instances. Save data remains\nauthoritative after generation and never re-derives this field."
    },
    "maxStack": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "meleeProfile": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttackProfileDefinition"
        },
        {
          "type": "null"
        }
