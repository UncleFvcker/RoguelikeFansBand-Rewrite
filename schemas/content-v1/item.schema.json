    "slays": {
      "additionalProperties": false,
      "default": {},
      "description": "Target categories receiving an original-compatible slay or kill\nmultiplier from melee weapon dice while this item is equipped.",
      "properties": {
        "animal": {
          "$ref": "#/$defs/SlayLevel"
        },
        "demon": {
