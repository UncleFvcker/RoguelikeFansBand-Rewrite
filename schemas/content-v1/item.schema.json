  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/item.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "abilityBookId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "appearanceNameKey": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "brands": {
      "default": [],
