        "attack": 0,
        "charisma": 0,
        "constitution": 0,
        "defense": 0,
        "dexterity": 0,
        "intelligence": 0,
        "maxHp": 0,
        "speed": 0,
        "strength": 0,
        "wisdom": 0
      }
