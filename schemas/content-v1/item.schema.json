        },
        "nether": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nexus": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nuke": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "physical": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "plasma": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "poison": {
