{
  "$defs": {
    "ItemQuality": {
      "enum": [
        "ordinary",
        "fine",
        "exceptional"
      ],
      "type": "string"
    },
    "LootAffixWeightDefinition": {
      "additionalProperties": false,
      "properties": {
        "affixId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "weight"
      ],
      "type": "object"
    },
    "LootEntryDefinition": {
      "additionalProperties": false,
      "properties": {
        "itemKindId": {
          "type": "string"
        },
        "maxDepth": {
          "default": 65535,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minDepth": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "quantity": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "weight": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "itemKindId",
        "weight",
        "quantity"
      ],
      "type": "object"
    },
    "LootQualityPolicyDefinition": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "goodCapPercent": {
              "format": "uint8",
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            "greatCapPercent": {
              "format": "uint8",
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "rfb-depth",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "goodCapPercent",
            "greatCapPercent"
          ],
          "type": "object"
        }
      ]
    },
    "LootQualityWeightDefinition": {
      "additionalProperties": false,
      "properties": {
        "quality": {
          "$ref": "#/$defs/ItemQuality"
        },
        "weight": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "quality",
        "weight"
      ],
      "type": "object"
    },
    "LootRfbEgoPolicyDefinition": {
      "enum": [
        "weapon-digger"
      ],
      "type": "string"
    },
    "LootRollDiceDefinition": {
      "additionalProperties": false,
      "properties": {
        "dice": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "sides": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dice",
        "sides"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/loot-table.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "affixWeights": {
      "items": {
        "$ref": "#/$defs/LootAffixWeightDefinition"
      },
      "type": "array"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/LootEntryDefinition"
      },
      "type": "array"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "qualityPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/LootQualityPolicyDefinition"
        },
        {
          "type": "null"
        }
      ]
    },
    "qualityWeights": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LootQualityWeightDefinition"
      },
      "type": "array"
    },
    "rfbEgoPolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/LootRfbEgoPolicyDefinition"
        },
        {
          "type": "null"
        }
      ]
    },
    "rollChancePercent": {
      "default": null,
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "rollDice": {
      "anyOf": [
        {
          "$ref": "#/$defs/LootRollDiceDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rolls": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "rolls",
    "entries",
    "affixWeights"
  ],
  "title": "LootTableDefinition",
  "type": "object"
}
