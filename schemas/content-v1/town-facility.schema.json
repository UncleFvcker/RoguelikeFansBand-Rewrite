{
  "$defs": {
    "ContentPosition": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "TownFacilityBountyDefinition": {
      "additionalProperties": false,
      "properties": {
        "wantedRewardItemKindIds": {
          "description": "The twenty source-ordered prizes for the character's wanted uniques.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "wantedRewardItemKindIds"
      ],
      "type": "object"
    },
    "TownFacilityCategory": {
      "enum": [
        "home",
        "quest-giver",
        "service"
      ],
      "type": "string"
    },
    "TownFacilityPrice": {
      "additionalProperties": false,
      "properties": {
        "otherCost": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ownerCost": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "ownerCost",
        "otherCost"
      ],
      "type": "object"
    },
    "TownFacilityServiceDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/TownFacilityServiceKind"
        },
        "otherCost": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ownerCost": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "ownerCost",
        "otherCost"
      ],
      "type": "object"
    },
    "TownFacilityServiceKind": {
      "enum": [
        "heal",
        "restore-vitality",
        "cure-mutation",
        "balance-ritual",
        "enchant-weapon",
        "enchant-armor",
        "enchant-ammunition",
        "enchant-bow",
        "assess-armor",
        "recall"
      ],
      "type": "string"
    },
    "TownFacilityTeleportDefinition": {
      "additionalProperties": false,
      "properties": {
        "price": {
          "$ref": "#/$defs/TownFacilityPrice"
        },
        "requiredCompletedTaskId": {
          "type": "string"
        }
      },
      "required": [
        "requiredCompletedTaskId",
        "price"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/town-facility.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "additionalEntrancePositions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContentPosition"
      },
      "type": "array"
    },
    "bountyOffice": {
      "anyOf": [
        {
          "$ref": "#/$defs/TownFacilityBountyDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "casino": {
      "default": false,
      "type": "boolean"
    },
    "category": {
      "$ref": "#/$defs/TownFacilityCategory"
    },
    "descriptionKey": {
      "type": "string"
    },
    "entrancePosition": {
      "$ref": "#/$defs/ContentPosition"
    },
    "entranceTerrainId": {
      "type": "string"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "identifyAllItemsCost": {
      "anyOf": [
        {
          "$ref": "#/$defs/TownFacilityPrice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "identifyItemCost": {
      "default": null,
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "innStayCost": {
      "anyOf": [
        {
          "$ref": "#/$defs/TownFacilityPrice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "legalNameChangeCost": {
      "default": null,
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "memberClassIds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "memberRaceIds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "memberRealmIds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "nameKey": {
      "type": "string"
    },
    "overviewMessageKey": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "ownerClassIds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ownerNameKey": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "ownerRaceIds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ownerRealmIds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "rejectArtifactDeposits": {
      "default": false,
      "type": "boolean"
    },
    "researchItemCost": {
      "default": null,
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "researchMonsterCost": {
      "anyOf": [
        {
          "$ref": "#/$defs/TownFacilityPrice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "serviceActions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TownFacilityServiceDefinition"
      },
      "type": "array"
    },
    "storageId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "taskIds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "teleportLevelCost": {
      "anyOf": [
        {
          "$ref": "#/$defs/TownFacilityPrice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "townId": {
      "type": "string"
    },
    "townTeleport": {
      "anyOf": [
        {
          "$ref": "#/$defs/TownFacilityTeleportDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "nameKey",
    "descriptionKey",
    "townId",
    "category",
    "entrancePosition",
    "entranceTerrainId"
  ],
  "title": "TownFacilityDefinition",
  "type": "object"
}
