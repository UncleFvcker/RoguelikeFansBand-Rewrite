{
  "$defs": {
    "AbilityLevelScalingCurveDefinition": {
      "enum": [
        "linear",
        "prorated"
      ],
      "type": "string"
    },
    "AbilityLevelScalingDefinition": {
      "additionalProperties": false,
      "properties": {
        "cubicWeight": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "curve": {
          "$ref": "#/$defs/AbilityLevelScalingCurveDefinition",
          "default": "linear"
        },
        "divisor": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "effectIndex": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "field": {
          "$ref": "#/$defs/AbilityLevelScalingField"
        },
        "levelOffset": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "maximum": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "multiplier": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "quadraticWeight": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "effectIndex",
        "field",
        "multiplier",
        "divisor"
      ],
      "type": "object"
    },
    "AbilityLevelScalingField": {
      "enum": [
        "damage-dice",
        "damage-sides",
        "damage-bonus",
        "death-ray-power",
        "teleport-away-power",
        "recharge-power",
        "identify-power",
        "radius",
        "beam-chance-percent",
        "status-intensity",
        "status-duration-ticks",
        "status-duration-sides",
        "status-defense",
        "status-power",
        "status-melee-damage",
        "control-power",
        "genocide-power",
        "summon-maximum-level",
        "maximum-weight",
        "banish-distance",
        "device-mastery-duration-base",
        "device-power-bonus",
        "maximum-range"
      ],
      "type": "string"
    },
    "AbilitySpellPowerDefinition": {
      "additionalProperties": false,
      "properties": {
        "effectIndex": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "field": {
          "$ref": "#/$defs/AbilitySpellPowerField"
        }
      },
      "required": [
        "effectIndex",
        "field"
      ],
      "type": "object"
    },
    "AbilitySpellPowerField": {
      "enum": [
        "final-damage",
        "damage-sides",
        "damage-bonus",
        "healing-amount",
        "healing-sides",
        "radius",
        "status-duration-ticks",
        "status-duration-sides",
        "status-power",
        "control-power",
        "genocide-power",
        "identify-power",
        "teleport-away-power",
        "recharge-power",
        "random-choice-roll",
        "malediction-death-ray-power",
        "malediction-fear-power",
        "maximum-weight",
        "banish-distance",
        "device-mastery-duration-base",
        "invulnerability-duration",
        "clairvoyance-duration-sides",
        "maximum-range"
      ],
      "type": "string"
    },
    "AbilityTargetDefinition": {
      "additionalProperties": false,
      "properties": {
        "modes": {
          "items": {
            "$ref": "#/$defs/AbilityTargetModeDefinition"
          },
          "type": "array"
        },
        "range": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "requiresLineOfEffect": {
          "type": "boolean"
        }
      },
      "required": [
        "modes",
        "range",
        "requiresLineOfEffect"
      ],
      "type": "object"
    },
    "AbilityTargetModeDefinition": {
      "enum": [
        "direction",
        "position",
        "entity",
        "item",
        "town",
        "self"
      ],
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/ability.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "abilityProgramId": {
      "type": "string"
    },
    "affectsGroundItems": {
      "default": false,
      "type": "boolean"
    },
    "descriptionKey": {
      "type": "string"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "levelScaling": {
      "items": {
        "$ref": "#/$defs/AbilityLevelScalingDefinition"
      },
      "type": "array"
    },
    "nameKey": {
      "type": "string"
    },
    "spellPowerFields": {
      "items": {
        "$ref": "#/$defs/AbilitySpellPowerDefinition"
      },
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "target": {
      "$ref": "#/$defs/AbilityTargetDefinition"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "nameKey",
    "descriptionKey",
    "target",
    "abilityProgramId",
    "tags"
  ],
  "title": "AbilityDefinition",
  "type": "object"
}
