        "learningCapacityPerAttributeIndex": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "learningCapacityPerLevel": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "learningFormula": {
          "$ref": "#/$defs/CastingLearningFormula",
          "default": "linear"
        },
        "minimumFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "realmProfiles": {
          "items": {
            "$ref": "#/$defs/CastingRealmProfileDefinition"
          },
          "type": "array"
        },
        "resourceId": {
          "type": "string"
        },
        "resourceRecoveryPercent": {
          "default": 100,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "spellDamageBonusBase": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "spellDamageBonusLevelDivisor": {
          "default": 1,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "spellDamageBonusPerLevel": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "studyMode": {
          "$ref": "#/$defs/CastingStudyMode"
        }
      },
      "required": [
        "resourceId",
        "castingAttribute",
        "baseCapacity",
        "capacityPerLevel",
        "capacityPerAttributeIndex",
        "baseLearningCapacity",
        "learningCapacityPerLevel",
        "learningCapacityPerAttributeIndex",
        "learningCapacityCap",
        "minimumFailurePercent",
