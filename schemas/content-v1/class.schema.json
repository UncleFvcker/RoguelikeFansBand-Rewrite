{
  "$defs": {
    "AbilityCastingOverrideDefinition": {
      "additionalProperties": false,
      "properties": {
        "abilityId": {
          "type": "string"
        },
        "baseFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "levelScaling": {
          "items": {
            "$ref": "#/$defs/AbilityLevelScalingDefinition"
          },
          "type": "array"
        },
        "minimumLevel": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "resourceCost": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "abilityId",
        "minimumLevel",
        "resourceCost",
        "baseFailurePercent"
      ],
      "type": "object"
    },
    "AbilityLevelScalingCurveDefinition": {
      "enum": [
        "linear",
        "prorated"
      ],
      "type": "string"
    },
    "AbilityLevelScalingDefinition": {
      "additionalProperties": false,
      "properties": {
        "cubicWeight": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "curve": {
          "$ref": "#/$defs/AbilityLevelScalingCurveDefinition",
          "default": "linear"
        },
        "divisor": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "effectIndex": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "field": {
          "$ref": "#/$defs/AbilityLevelScalingField"
        },
        "levelOffset": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "maximum": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "multiplier": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "quadraticWeight": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "effectIndex",
        "field",
        "multiplier",
        "divisor"
      ],
      "type": "object"
    },
    "AbilityLevelScalingField": {
      "enum": [
        "damage-dice",
        "damage-sides",
        "damage-bonus",
        "death-ray-power",
        "identify-power",
        "radius",
        "beam-chance-percent",
        "status-intensity",
        "status-duration-ticks",
        "status-duration-sides",
        "status-power",
        "status-melee-damage",
        "control-power",
        "genocide-power",
        "summon-maximum-level",
        "maximum-weight"
      ],
      "type": "string"
    },
    "CastingAttribute": {
      "enum": [
        "intelligence",
        "wisdom",
        "charisma"
      ],
      "type": "string"
    },
    "CastingCapacityFormula": {
      "enum": [
        "linear",
        "rfb-mana"
      ],
      "type": "string"
    },
    "CastingEncumbranceDefinition": {
      "additionalProperties": false,
      "properties": {
        "gloveEncumbrance": {
          "default": false,
          "type": "boolean"
        },
        "maximumWeightTenthsPound": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "penaltyWeightTenthsPound": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "weaponWeightPercent": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "maximumWeightTenthsPound",
        "weaponWeightPercent",
        "penaltyWeightTenthsPound"
      ],
      "type": "object"
    },
    "CastingFailureFormula": {
      "enum": [
        "linear",
        "rfb-magic"
      ],
      "type": "string"
    },
    "CastingLearningFormula": {
      "enum": [
        "linear",
        "rfb-single-realm"
      ],
      "type": "string"
    },
    "CastingProfileDefinition": {
      "additionalProperties": false,
      "properties": {
        "baseCapacity": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "baseLearningCapacity": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "beamChanceBonus": {
          "default": 0,
          "format": "int8",
          "maximum": 127,
          "minimum": -128,
          "type": "integer"
        },
        "beamChanceLevelDivisor": {
          "default": 1,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "beamChanceLevelMultiplier": {
          "default": 0,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "capacityFormula": {
          "$ref": "#/$defs/CastingCapacityFormula",
          "default": "linear"
        },
        "capacityPerAttributeIndex": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "capacityPerLevel": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "capacityPercent": {
          "default": 100,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "castingAttribute": {
          "$ref": "#/$defs/CastingAttribute"
        },
        "encumbrance": {
          "anyOf": [
            {
              "$ref": "#/$defs/CastingEncumbranceDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "failureFormula": {
          "$ref": "#/$defs/CastingFailureFormula",
          "default": "linear"
        },
        "learningCapacityCap": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "learningCapacityPerAttributeIndex": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "learningCapacityPerLevel": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "learningFormula": {
          "$ref": "#/$defs/CastingLearningFormula",
          "default": "linear"
        },
        "minimumFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "realmProfiles": {
          "items": {
            "$ref": "#/$defs/CastingRealmProfileDefinition"
          },
          "type": "array"
        },
        "resourceId": {
          "type": "string"
        },
        "resourceRecoveryPercent": {
          "default": 100,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "spellDamageBonusBase": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "spellDamageBonusLevelDivisor": {
          "default": 1,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "spellDamageBonusPerLevel": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "resourceId",
        "castingAttribute",
        "baseCapacity",
        "capacityPerLevel",
        "capacityPerAttributeIndex",
        "baseLearningCapacity",
        "learningCapacityPerLevel",
        "learningCapacityPerAttributeIndex",
        "learningCapacityCap",
        "minimumFailurePercent",
        "realmProfiles"
      ],
      "type": "object"
    },
    "CastingRealmProfileDefinition": {
      "additionalProperties": false,
      "properties": {
        "abilityBookIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "abilityOverrides": {
          "items": {
            "$ref": "#/$defs/AbilityCastingOverrideDefinition"
          },
          "type": "array"
        },
        "learningCapacityBonus": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "realmId": {
          "type": "string"
        }
      },
      "required": [
        "realmId",
        "abilityBookIds"
      ],
      "type": "object"
    },
    "ClassAbilityDefinition": {
      "additionalProperties": false,
      "properties": {
        "abilityId": {
          "type": "string"
        },
        "baseFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "governingAttribute": {
          "$ref": "#/$defs/TechniqueAttribute"
        },
        "minimumFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "minimumLevel": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "resourceCost": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "resourceId": {
          "type": "string"
        }
      },
      "required": [
        "abilityId",
        "minimumLevel",
        "governingAttribute",
        "resourceId",
        "resourceCost",
        "baseFailurePercent",
        "minimumFailurePercent"
      ],
      "type": "object"
    },
    "StartingItemDefinition": {
      "additionalProperties": false,
      "properties": {
        "equipped": {
          "default": false,
          "type": "boolean"
        },
        "itemKindId": {
          "type": "string"
        },
        "maximumQuantity": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "quantity": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "itemKindId",
        "quantity"
      ],
      "type": "object"
    },
    "StatModifiers": {
      "additionalProperties": false,
      "properties": {
        "attack": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "charisma": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "constitution": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "defense": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "dexterity": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "intelligence": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "maxHp": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "speed": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "strength": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "wisdom": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "TechniqueAttribute": {
      "enum": [
        "strength",
        "intelligence",
        "wisdom",
        "dexterity",
        "constitution",
        "charisma"
      ],
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/class.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "abilities": {
      "items": {
        "$ref": "#/$defs/ClassAbilityDefinition"
      },
      "type": "array"
    },
    "baseHp": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "castingProfile": {
      "anyOf": [
        {
          "$ref": "#/$defs/CastingProfileDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "descriptionKey": {
      "type": "string"
    },
    "experiencePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "favoriteWeaponTags": {
      "default": [],
      "description": "Item tags accepted by Mogaminator's favorite-weapon predicate.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "ickyEquipmentSlots": {
      "default": [],
      "description": "Equipment slot types known to be uncomfortable for this class.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "lifePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "modifiers": {
      "$ref": "#/$defs/StatModifiers",
      "default": {
        "attack": 0,
        "charisma": 0,
        "constitution": 0,
        "defense": 0,
        "dexterity": 0,
        "intelligence": 0,
        "maxHp": 0,
        "speed": 0,
        "strength": 0,
        "wisdom": 0
      }
    },
    "nameKey": {
      "type": "string"
    },
    "skillSetId": {
      "type": "string"
    },
    "specialItemTags": {
      "default": [],
      "description": "Item tags with class-specific utility that ordinary rules must retain.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "startingItems": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StartingItemDefinition"
      },
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "usesSpellScrolls": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "nameKey",
    "descriptionKey",
    "skillSetId",
    "tags"
  ],
  "title": "ClassDefinition",
  "type": "object"
}
