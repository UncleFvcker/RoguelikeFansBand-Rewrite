{
  "$defs": {
    "CastingAttribute": {
      "enum": [
        "intelligence",
        "wisdom",
        "charisma"
      ],
      "type": "string"
    },
    "CastingProfileDefinition": {
      "additionalProperties": false,
      "properties": {
        "abilityBookIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "baseCapacity": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "baseLearningCapacity": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "capacityPerAttributeIndex": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "capacityPerLevel": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "castingAttribute": {
          "$ref": "#/$defs/CastingAttribute"
        },
        "learningCapacityCap": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "learningCapacityPerAttributeIndex": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "learningCapacityPerLevel": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "minimumFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "resourceId": {
          "type": "string"
        }
      },
      "required": [
        "resourceId",
        "castingAttribute",
        "baseCapacity",
        "capacityPerLevel",
        "capacityPerAttributeIndex",
        "baseLearningCapacity",
        "learningCapacityPerLevel",
        "learningCapacityPerAttributeIndex",
        "learningCapacityCap",
        "minimumFailurePercent",
        "abilityBookIds"
      ],
      "type": "object"
    },
    "StartingItemDefinition": {
      "additionalProperties": false,
      "properties": {
        "equipped": {
          "default": false,
          "type": "boolean"
        },
        "itemKindId": {
          "type": "string"
        },
        "quantity": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "itemKindId",
        "quantity"
      ],
      "type": "object"
    },
    "StatModifiers": {
      "additionalProperties": false,
      "properties": {
        "attack": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "charisma": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "constitution": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "defense": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "dexterity": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "intelligence": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "maxHp": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "strength": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "wisdom": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/class.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "baseHp": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "castingProfile": {
      "anyOf": [
        {
          "$ref": "#/$defs/CastingProfileDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "descriptionKey": {
      "type": "string"
    },
    "experiencePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "lifePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "modifiers": {
      "$ref": "#/$defs/StatModifiers",
      "default": {
        "attack": 0,
        "charisma": 0,
        "constitution": 0,
        "defense": 0,
        "dexterity": 0,
        "intelligence": 0,
        "maxHp": 0,
        "strength": 0,
        "wisdom": 0
      }
    },
    "nameKey": {
      "type": "string"
    },
    "skillSetId": {
      "type": "string"
    },
    "startingItems": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StartingItemDefinition"
      },
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "nameKey",
    "descriptionKey",
    "skillSetId",
    "tags"
  ],
  "title": "ClassDefinition",
  "type": "object"
}
