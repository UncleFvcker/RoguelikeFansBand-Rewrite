          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "penaltyWeightTenthsPound": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "weaponWeightPercent": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
