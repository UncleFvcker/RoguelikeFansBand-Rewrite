  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/class.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "abilities": {
      "items": {
        "$ref": "#/$defs/ClassAbilityDefinition"
      },
      "type": "array"
    },
    "ammunitionBreakageFactorModifier": {
      "default": 0,
      "description": "Percentage-point change to RFB's shooter breakage factor.",
      "format": "int16",
      "maximum": 32767,
      "minimum": -32768,
      "type": "integer"
    },
    "baseHp": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "castingProfile": {
      "anyOf": [
        {
          "$ref": "#/$defs/CastingProfileDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "descriptionKey": {
      "type": "string"
    },
    "experiencePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "favoriteWeaponTags": {
      "default": [],
      "description": "Item tags accepted by Mogaminator's favorite-weapon predicate.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "ickyEquipmentSlots": {
      "default": [],
      "description": "Equipment slot types known to be uncomfortable for this class.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "levelResistances": {
      "description": "Intrinsic resistance tiers gained when the character reaches a class\nlevel threshold.",
      "items": {
        "$ref": "#/$defs/ClassLevelResistanceDefinition"
      },
      "type": "array"
    },
    "lifePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "modifiers": {
      "$ref": "#/$defs/StatModifiers",
      "default": {
        "attack": 0,
        "charisma": 0,
        "constitution": 0,
        "defense": 0,
        "dexterity": 0,
        "intelligence": 0,
        "maxHp": 0,
        "speed": 0,
        "spellPowerBonus": 0,
        "strength": 0,
        "wisdom": 0
      }
    },
    "mountedNonArrowBaseShotCap": {
      "description": "Optional RFB class cap applied to mounted non-arrow shooting speed.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "nameKey": {
      "type": "string"
    },
    "petUpkeepDivisor": {
      "default": 40,
      "description": "RFB class divisor used to convert controlled monster levels into mana upkeep.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "projectileCriticalChanceBonusPercentPerLevel": {
      "default": 0,
      "description": "RFB ranged-critical chance bonus gained for each character level.",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "ridingCombatExpert": {
      "default": false,
      "description": "Uses the Beastmaster/Cavalry mounted attack penalties instead of the\nordinary rider formula.",
      "type": "boolean"
    },
    "ridingProficiency": {
      "$ref": "#/$defs/RidingProficiencyDefinition",
      "description": "RFB riding proficiency at birth and the class training ceiling."
