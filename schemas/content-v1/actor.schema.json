{
  "$defs": {
    "ActorAwarenessDefinition": {
      "additionalProperties": false,
      "properties": {
        "detectionDifficulty": {
          "format": "int32",
          "type": "integer"
        },
        "detectionRange": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "startsAlerted": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "detectionDifficulty",
        "detectionRange"
      ],
      "type": "object"
    },
    "ActorDamageType": {
      "enum": [
        "physical",
        "acid",
        "electricity",
        "fire",
        "cold",
        "poison",
        "light",
        "dark",
        "confusion",
        "nether",
        "nexus",
        "sound",
        "shards",
        "chaos",
        "disenchant",
        "time",
        "mana",
        "gravity",
        "inertia",
        "plasma",
        "force",
        "nuke",
        "disintegrate",
        "storm",
        "holy-fire",
        "hell-fire",
        "ice",
        "water",
        "psi"
      ],
      "type": "string"
    },
    "ActorResistanceLevel": {
      "description": "Content-declared resistance tier; `normal` is expressed by omission.",
      "enum": [
        "vulnerable",
        "resistant",
        "strong",
        "immune"
      ],
      "type": "string"
    },
    "ActorRole": {
      "enum": [
        "player",
        "monster"
      ],
      "type": "string"
    },
    "MeleeBlowDefinition": {
      "additionalProperties": false,
      "properties": {
        "damageDice": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "damageSides": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "damageType": {
          "$ref": "#/$defs/ActorDamageType",
          "default": "physical"
        },
        "methodId": {
          "type": "string"
        },
        "toHit": {
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "methodId",
        "toHit",
        "damageDice",
        "damageSides"
      ],
      "type": "object"
    },
    "MeleeRoutineDefinition": {
      "additionalProperties": false,
      "properties": {
        "blows": {
          "items": {
            "$ref": "#/$defs/MeleeBlowDefinition"
          },
          "type": "array"
        }
      },
      "required": [
        "blows"
      ],
      "type": "object"
    },
    "MonsterAbilityCandidateDefinition": {
      "additionalProperties": false,
      "properties": {
        "abilityId": {
          "type": "string"
        },
        "weight": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "abilityId",
        "weight"
      ],
      "type": "object"
    },
    "MonsterCastingDefinition": {
      "additionalProperties": false,
      "properties": {
        "abilities": {
          "items": {
            "$ref": "#/$defs/MonsterAbilityCandidateDefinition"
          },
          "type": "array"
        },
        "fleeHpPercent": {
          "default": 0,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "frequencyPercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "preferredDistance": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "smart": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "frequencyPercent",
        "abilities"
      ],
      "type": "object"
    },
    "MonsterRemainsDefinition": {
      "additionalProperties": false,
      "properties": {
        "chanceDenominator": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "corpseItemKindId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "corpseWeight": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "skeletonItemKindId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "skeletonWeight": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "chanceDenominator"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/actor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "attack": {
      "format": "int32",
      "type": "integer"
    },
    "awareness": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorAwarenessDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bashPower": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "carriedLootTableId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "carryCapacityTenthsPound": {
      "default": 0,
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "corpseItemKindId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "damageDice": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "damageSides": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "damageType": {
      "$ref": "#/$defs/ActorDamageType",
      "default": "physical"
    },
    "defense": {
      "format": "int32",
      "type": "integer"
    },
    "descriptionKey": {
      "type": "string"
    },
    "digSkill": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "disarmSkill": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "doorSkill": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "experienceValue": {
      "default": 0,
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "glyph": {
      "type": "string"
    },
    "goldDropChancePercent": {
      "default": null,
      "description": "Chance that a successful death-loot roll becomes gold instead of an item.",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "inventorySlotCapacity": {
      "default": 0,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "level": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "lootTableId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "maxHp": {
      "format": "int32",
      "type": "integer"
    },
    "meleeRoutine": {
      "anyOf": [
        {
          "$ref": "#/$defs/MeleeRoutineDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "monsterCasting": {
      "anyOf": [
        {
          "$ref": "#/$defs/MonsterCastingDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "nameKey": {
      "type": "string"
    },
    "remains": {
      "anyOf": [
        {
          "$ref": "#/$defs/MonsterRemainsDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resistances": {
      "additionalProperties": false,
      "properties": {
        "acid": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "chaos": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "cold": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "confusion": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "dark": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "disenchant": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "disintegrate": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "electricity": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "fire": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "force": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "gravity": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "hell-fire": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "holy-fire": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "ice": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "inertia": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "light": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "mana": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nether": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nexus": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nuke": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "physical": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "plasma": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "poison": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "psi": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "shards": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "sound": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "storm": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "time": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "water": {
          "$ref": "#/$defs/ActorResistanceLevel"
        }
      },
      "type": "object"
    },
    "role": {
      "$ref": "#/$defs/ActorRole"
    },
    "searchSkill": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "speed": {
      "default": 110,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "statusImmunities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "role",
    "nameKey",
    "descriptionKey",
    "glyph",
    "level",
    "maxHp",
    "attack",
    "defense",
    "damageDice",
    "damageSides",
    "tags"
  ],
  "title": "ActorDefinition",
  "type": "object"
}
