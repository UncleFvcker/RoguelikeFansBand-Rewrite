  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/race.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "abilities": {
      "description": "RFB innate powers supplied by the currently effective race.",
      "items": {
        "$ref": "#/$defs/InnatePowerDefinition"
      },
      "type": "array"
    },
    "armorClass": {
      "default": 0,
      "description": "Direct intrinsic armor-class adjustment supplied by the effective race.",
      "format": "int32",
      "type": "integer"
    },
    "attributeSustains": {
      "description": "Attributes this race innately prevents from being reduced.",
      "items": {
        "$ref": "#/$defs/ItemAttributeDefinition"
      },
      "type": "array",
      "uniqueItems": true
    },
    "baseHp": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "bodySlots": {
      "default": [],
      "description": "Equipment slot instances this race's body offers. Empty means the\nengine's standard body template applies.",
      "items": {
        "$ref": "#/$defs/BodySlotDefinition"
      },
      "type": "array"
    },
    "descriptionKey": {
      "type": "string"
    },
    "experiencePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "foodNutritionDivisor": {
      "default": 1,
      "description": "Divisor applied to nutrition gained from ordinary food effects.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "healingReceivedPercent": {
      "default": 100,
      "description": "Percentage of shared player-healing effects retained by this effective race.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "holdLifeMinimumLevel": {
      "description": "Character level at which this effective race gains intrinsic hold life.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "infravision": {
      "default": 0,
      "description": "Intrinsic infravision range in map cells.",
      "format": "int32",
      "type": "integer"
    },
    "kinCategory": {
      "default": null,
      "description": "Actor category used by player-kin summons. Omission makes that race\nproduce an observed zero-result summon instead of guessing ancestry.",
      "type": [
        "string",
        "null"
      ]
    },
    "legacyIndex": {
      "description": "Original RFB race or mimic index. Temporary-form mechanics use this\nstable source identity instead of depending on localized names.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "levelMutationRewards": {
      "description": "Level-gated race mutations. Completion is represented by the chosen\nmutation being present in the character's locked mutation set.",
      "items": {
        "$ref": "#/$defs/RaceLevelMutationRewardDefinition"
      },
      "type": "array"
    },
    "levelResistances": {
      "description": "Intrinsic resistance tiers gained at a character-level threshold while\nthis is the currently effective race.",
      "items": {
        "$ref": "#/$defs/LevelResistanceDefinition"
      },
      "type": "array"
    },
    "levelStatScalings": {
      "description": "Intrinsic derived-stat adjustments scaled from character level while\nthis is the currently effective race.",
      "items": {
        "$ref": "#/$defs/RaceLevelStatScalingDefinition"
      },
      "type": "array"
    },
    "levitation": {
      "description": "Whether the effective race can cross terrain that requires levitation.",
      "type": "boolean"
    },
    "lifePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "modifiers": {
      "$ref": "#/$defs/StatModifiers",
      "default": {
        "attack": 0,
        "charisma": 0,
        "constitution": 0,
        "defense": 0,
        "devicePowerBonus": 0,
        "dexterity": 0,
        "intelligence": 0,
        "maxHp": 0,
        "speed": 0,
        "spellPowerBonus": 0,
        "strength": 0,
        "wisdom": 0
      }
    },
    "mutationChoiceExclusionsByClass": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "description": "Mutations omitted from a manual race reward for a specific class.",
      "type": "object"
    },
    "mutationOverrides": {
      "additionalProperties": {
        "$ref": "#/$defs/RaceMutationOverrideDefinition"
      },
      "description": "Birth-race-specific behavior for mutations granted by this race.",
      "type": "object"
    },
    "nameKey": {
      "type": "string"
    },
    "reflectsBoltsMinimumLevel": {
      "description": "Character level at which this effective race begins reflecting bolts.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "regenerationRateModifierPercent": {
      "default": 0,
      "description": "Additive percentage adjustment to the natural HP regeneration rate.",
      "format": "int32",
      "type": "integer"
    },
