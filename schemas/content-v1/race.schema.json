      "enum": [
        "physical",
        "acid",
        "electricity",
        "fire",
        "cold",
        "poison",
        "light",
        "dark",
        "blindness",
        "fear",
        "confusion",
        "nether",
        "nexus",
        "sound",
        "shards",
        "rock",
        "chaos",
        "disenchant",
        "time",
        "mana",
        "gravity",
        "inertia",
        "plasma",
        "force",
        "nuke",
        "disintegrate",
        "storm",
        "holy-fire",
        "hell-fire",
        "ice",
        "water",
        "psi",
        "curse",
        "meteor",
        "rocket",
        "telekinesis"
      ],
      "type": "string"
    },
    "ActorResistanceLevel": {
      "description": "Content-declared resistance tier; `normal` is expressed by omission.",
      "enum": [
        "vulnerable",
        "resistant",
        "strong",
        "immune"
      ],
      "type": "string"
    },
    "BodySlotDefinition": {
      "additionalProperties": false,
      "description": "One equipment slot instance on a body: `slot_type` is the item-facing\nclass (matches `ItemDefinition.equipment_slot`), `id` names the instance\nso a body can carry several slots of the same type (e.g. two rings).",
      "properties": {
        "id": {
          "type": "string"
        },
        "slotType": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slotType"
      ],
      "type": "object"
    },
    "InnatePowerCostScalingCurveDefinition": {
      "enum": [
        "step",
        "prorated"
      ],
      "type": "string"
    },
    "InnatePowerCostScalingDefinition": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cubicWeight": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "curve": {
          "$ref": "#/$defs/InnatePowerCostScalingCurveDefinition",
          "default": "step"
        },
        "divisor": {
          "default": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "levelInterval": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "linearWeight": {
          "default": 1,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "quadraticWeight": {
          "default": 0,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "roundUp": {
          "default": false,
          "type": "boolean"
        },
        "startLevel": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "startLevel",
        "levelInterval",
        "amount"
      ],
      "type": "object"
    },
    "InnatePowerDefinition": {
      "additionalProperties": false,
      "properties": {
        "abilityId": {
          "type": "string"
        },
        "baseFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "cost": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "costScaling": {
          "anyOf": [
            {
              "$ref": "#/$defs/InnatePowerCostScalingDefinition"
            },
            {
              "type": "null"
            }
          ]
        },
        "governingAttribute": {
          "$ref": "#/$defs/TechniqueAttribute"
        },
        "minimumFailurePercent": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "minimumLevel": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "minimumLevel",
        "governingAttribute",
        "cost",
        "baseFailurePercent",
        "abilityId"
      ],
      "type": "object"
    },
