    "RaceMutationSelectionDefinition": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mutationIds": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "choice",
              "type": "string"
            }
          },
          "required": [
            "type",
            "mutationIds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "defaultMutationId": {
              "type": "string"
            },
