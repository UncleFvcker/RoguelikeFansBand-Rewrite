{
  "$defs": {
    "ActorResistanceLevel": {
      "description": "Content-declared resistance tier; `normal` is expressed by omission.",
      "enum": [
        "vulnerable",
        "resistant",
        "strong",
        "immune"
      ],
      "type": "string"
    },
    "BodySlotDefinition": {
      "additionalProperties": false,
      "description": "One equipment slot instance on a body: `slot_type` is the item-facing\nclass (matches `ItemDefinition.equipment_slot`), `id` names the instance\nso a body can carry several slots of the same type (e.g. two rings).",
      "properties": {
        "id": {
          "type": "string"
        },
        "slotType": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slotType"
      ],
      "type": "object"
    },
    "StartingItemDefinition": {
      "additionalProperties": false,
      "properties": {
        "equipped": {
          "default": false,
          "type": "boolean"
        },
        "itemKindId": {
          "type": "string"
        },
        "quantity": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "itemKindId",
        "quantity"
      ],
      "type": "object"
    },
    "StatModifiers": {
      "additionalProperties": false,
      "properties": {
        "attack": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "charisma": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "constitution": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "defense": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "dexterity": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "intelligence": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "maxHp": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "speed": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "strength": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        },
        "wisdom": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/content-v1/race.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "baseHp": {
      "default": 0,
      "format": "int32",
      "type": "integer"
    },
    "bodySlots": {
      "default": [],
      "description": "Equipment slot instances this race's body offers. Empty means the\nengine's standard body template applies.",
      "items": {
        "$ref": "#/$defs/BodySlotDefinition"
      },
      "type": "array"
    },
    "descriptionKey": {
      "type": "string"
    },
    "experiencePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "formatVersion": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "kinCategory": {
      "default": null,
      "description": "Actor category used by player-kin summons. Omission makes that race\nproduce an observed zero-result summon instead of guessing ancestry.",
      "type": [
        "string",
        "null"
      ]
    },
    "lifePercent": {
      "default": 100,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "modifiers": {
      "$ref": "#/$defs/StatModifiers",
      "default": {
        "attack": 0,
        "charisma": 0,
        "constitution": 0,
        "defense": 0,
        "dexterity": 0,
        "intelligence": 0,
        "maxHp": 0,
        "speed": 0,
        "strength": 0,
        "wisdom": 0
      }
    },
    "nameKey": {
      "type": "string"
    },
    "resistances": {
      "additionalProperties": false,
      "default": {},
      "description": "Intrinsic resistance tiers every member of this race carries.",
      "properties": {
        "acid": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "chaos": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "cold": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "confusion": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "dark": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "disenchant": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "disintegrate": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "electricity": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "fire": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "force": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "gravity": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "hell-fire": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "holy-fire": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "ice": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "inertia": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "light": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "mana": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nether": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nexus": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "nuke": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "physical": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "plasma": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "poison": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "psi": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "shards": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "sound": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "storm": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "time": {
          "$ref": "#/$defs/ActorResistanceLevel"
        },
        "water": {
          "$ref": "#/$defs/ActorResistanceLevel"
        }
      },
      "type": "object"
    },
    "skillSetId": {
      "type": "string"
    },
    "startingItems": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StartingItemDefinition"
      },
      "type": "array"
    },
    "statusImmunities": {
      "default": [],
      "description": "Status kind ids members of this race are innately immune to.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "$schema",
    "formatVersion",
    "id",
    "nameKey",
    "descriptionKey",
    "skillSetId",
    "tags"
  ],
  "title": "RaceDefinition",
  "type": "object"
}
