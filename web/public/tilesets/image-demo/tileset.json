{
  "$schema": "https://raw.githubusercontent.com/UncleFvcker/RoguelikeFansBand-Rewrite/main/schemas/tileset-v1.schema.json",
  "format": "rfb-tileset",
  "formatVersion": 1,
  "id": "rfb.tileset.image-demo",
  "labelKey": "tileset-image-demo-label",
  "mode": "image",
  "tileWidth": 28,
  "tileHeight": 28,
  "atlas": {
    "source": "tiles.svg",
    "columns": 3,
    "rows": 1
  },
  "mappings": {
    "demo.terrain.floor": {
      "foreground": "#dce6f2",
      "background": "#111820",
      "tile": { "x": 0, "y": 0 }
    },
    "demo.terrain.wall": {
      "foreground": "#dce6f2",
      "background": "#26303d",
      "tile": { "x": 1, "y": 0 }
    },
    "demo.terrain.magma-vein": {
      "foreground": "#a85d3b",
      "background": "#30231f",
      "tile": { "x": 1, "y": 0 }
    },
    "demo.terrain.quartz-vein": {
      "foreground": "#c7c2b7",
      "background": "#33343a",
      "tile": { "x": 1, "y": 0 }
    },
    "demo.terrain.surface-grass": {
      "glyph": "\"",
      "foreground": "#6f9d62",
      "background": "#111b14"
    },
    "demo.terrain.surface-path": {
      "glyph": "·",
      "foreground": "#b69a68",
      "background": "#211b12"
