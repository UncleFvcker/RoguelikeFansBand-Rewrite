      "glyph": "1",
      "foreground": "#f0ca72",
      "background": "#3a2d1b"
    },
    "demo.actor.explorer": {
      "foreground": "#8ed8ff",
      "background": "#17324a",
      "tile": { "x": 2, "y": 0 }
    },
    "demo.actor.ember-mote": {
      "glyph": "✦",
      "foreground": "#ff9b5e",
      "background": "#47251c"
    },
    "demo.item.luminous-shard": {
      "foreground": "#f6e58d",
