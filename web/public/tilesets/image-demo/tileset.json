    "core.gold.gold": {
      "glyph": "$",
      "foreground": "#e2bb57",
      "background": "#272116"
    },
    "core.gold.opals": {
      "glyph": "$",
      "foreground": "#e2d6e8",
      "background": "#242127"
    },
    "core.gold.sapphires": {
      "glyph": "$",
      "foreground": "#6f9ed8",
      "background": "#182130"
    },
    "core.gold.rubies": {
      "glyph": "$",
      "foreground": "#cf4d62",
      "background": "#29181c"
